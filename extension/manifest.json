{
  "manifest_version": 3,
  "name": "PhishGuard",
  "version": "1.0",
  "description": "Warns users about phishing sites.",

  "permissions": ["activeTab", "scripting"],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "web_accessible_resources": [
    {
    "resources": ["warning.js", "warning.css"],
    "matches": ["<all_urls>"]
    }

  ]
}
